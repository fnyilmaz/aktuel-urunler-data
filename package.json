{
  "name": "aktuel-urunler-veri-yonetimi",
  "version": "1.0.0",
  "description": "BİM, A101 ve ŞOK Aktüel Broşür & Ürün Veri Çekme, Doğrulama ve Canlı GitHub Yayınlama Aracı",
  "main": "scripts/catalog_manager.js",
  "scripts": {
    "status": "node scripts/catalog_manager.js status",
    "validate": "node scripts/catalog_manager.js validate",
    "publish": "node scripts/catalog_manager.js publish",
    "backup": "node scripts/catalog_manager.js backup",
    "scrape:bim": "node scripts/ai_sync_workflow.js --market bim",
    "scrape:a101": "node scripts/ai_sync_workflow.js --market a101",
    "scrape:sok": "node scripts/ai_sync_workflow.js --market sok",
    "scrape:migros": "node scripts/ai_sync_workflow.js --market migros",
    "scrape:carrefoursa": "node scripts/ai_sync_workflow.js --market carrefoursa",
    "scrape:all": "node scripts/ai_sync_workflow.js --market all",
    "ai-sync": "node scripts/ai_sync_workflow.js"
  },
  "keywords": [
    "aktuel-urunler",
    "scraper",
    "bim",
    "a101",
    "sok",
    "catalog",
    "brochure"
  ],
  "author": "fnyilmaz",
  "license": "MIT",
  "dependencies": {
    "puppeteer-core": "^25.11.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "tweetsodium": "^0.0.4"
  }
}
